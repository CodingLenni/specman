// {"specmanVersion":"1.3.0","modelType":"specman.model.v002.DiagramModel_V002"}
// Specman: frame0
// Format defined by grammar: SpecmanModel_V002.g4
// Step numbers (first parameter of each step): unique diagram-wide; referenced by catch blocks and step links in text; sanitizer renumbers consistently
// plain=`...` fields: plain-text rendition, regenerated by Specman on every sanitize run
// markups=[...] fields: change-tracking annotations, maintained by Specman
// image(...) { [base64:...] } blocks: embedded binary image data (base64-encoded)

settings {
    width=700
    zoom=100
    changeModeEnabled=false
    changeSetName=orange
}

intro(`<h1>
      Specman Reference
    </h1>
    <div>
      This modell includes all modelling elements supported by Specman, mainly 
      to derive a JSON schema from it.
    </div>
    <div>
      This section is the intro of a usecase.
    </div>`, plain=`Specman Reference
This modell includes all modelling elements supported by Specman, mainly to derive a JSON schema from it.
This section is the intro of a usecase.`) {
}

mainSequence {
    simple(1, e0ae00ba, `Simple step. Every step has an ID which is automatically modified when the 
    step changes its position within the step sequence. The IDs always make up 
    a gapless number sequence. Specman immediately renumbers steps when they 
    are moved or steps are inserted before.`, plain=`Simple step. Every step has an ID which is automatically modified when the step changes its position within the step sequence. The IDs always make up a gapless number sequence. Specman immediately renumbers steps when they are moved or steps are inserted before.`);
    while(2, bbb7eb64, `While loop`, plain=`While loop`, barWidth=18) {
        simple(2.1, e50f52c1, `Steps being run with every repetition of the loop.`, plain=`Steps being run with every repetition of the loop.`);
    }
    doWhile(3, 68efffd1, `While while loop. There is no sementical difference to the while loop. Its 
    more a matter of preference, if things become clearer by the extra bottom 
    bar.`, plain=`While while loop. There is no sementical difference to the while loop. Its more a matter of preference, if things become clearer by the extra bottom bar.`, barWidth=18) {
        simple(3.1, 5f1b8006, `Steps being run with every repetition of the loop.`, plain=`Steps being run with every repetition of the loop.`);
    }
    simple(4, fe4b0168, `As step refering to another step by its number 1. The reference number is 
    automatically updated, when the refered step changes its number.`, plain=`As step refering to another step by its number 1. The reference number is automatically updated, when the refered step changes its number.`, markups=[(47,47,Steplink)]);
    source(5, 28edc987, `<strike><font color="#c0c0c0" size="1">.</font></strike>`, plain=`.`, markups=[(0,0,Changed,orange)], orange);
    simple(6, b75f10bd, `A step being added in the yellow change set. Step reference to step 2.`, plain=`A step being added in the yellow change set. Step reference to step 2.`, markups=[(0,67,Changed,yellow)(68,68,ChangedSteplink,yellow)(69,69,Changed,yellow)], change=(added, yellow));
    simple(7, 273bf30a, `A step with text being added and <strike>text being deleted </strike>in 
    the yellow change set.`, plain=`A step with text being added and text being deleted in the yellow change set.`, markups=[(12,32,Changed,yellow)(33,51,Changed,yellow)(52,75,Changed,yellow)]);
    simple(8, f39c4ba0, `This step has been removed in the blue changeset`, plain=`This step has been removed in the blue changeset`, change=(removed, blue));
    simple(9, 000c0a7f, `<div>
      Available change sets are:
    </div>`, plain=`Available change sets are:`) {
        list(ordered=false) {
            item(`yellow`, plain=`yellow`, markups=[(0,5,Changed,yellow)], change=(added, yellow))
            item(`lilac`, plain=`lilac`, markups=[(0,4,Changed,lilac)], change=(added, yellow))
            item(`blue`, plain=`blue`, markups=[(0,3,Changed,blue)], change=(added, yellow))
            item(`orange`, plain=`orange`, markups=[(0,5,Changed,orange)], change=(added, yellow))
            item(`pink`, plain=`pink`, markups=[(0,3,Changed,pink)], change=(added, yellow))
        }
        text(`Trailing text from yellow change set`, plain=`Trailing text from yellow change set`, markups=[(0,35,Changed,yellow)])
    }
    break(10, 85904142, `<b>Exception 1 - should have single line text</b>`, plain=`Exception 1 - should have single line text`);
    ifElse(11, 274986f1, `<div align="center">
      If-Else-Step. The field in here contains the condition to check for. 
      Might by expressed as a question.
    </div>`, plain=`If-Else-Step. The field in here contains the condition to check for. Might by expressed as a question.`, ifRatio=50.00%) {
        if_branch(`Heading of the Yes-Sequence, of the question can be answered by &quot;yes&quot; or 
    &quot;no&quot;. However, it is recommended not to work with Yes-No-Questions.`, plain=`Heading of the Yes-Sequence, of the question can be answered by "yes" or "no". However, it is recommended not to work with Yes-No-Questions.`) {
            simple(11.1, f74ef187, `Steps being run in the Yes-Case`, plain=`Steps being run in the Yes-Case`);
        }
        else_branch(`<div align="right">
      Heading of the No-Sequence
    </div>`, plain=`Heading of the No-Sequence`) {
            simple(12.1, a4d35769, `Steps to be run in the No-Case`, plain=`Steps to be run in the No-Case`);
        }
    }
    break(13, be6eef1b, `<b>Exception 2</b>`, plain=`Exception 2`);
    if(14, a0a0818b, `<div align="center">
      If-Step as a special form of an If-Else-Step which simply has no 
      No-Sequence
    </div>`, plain=`If-Step as a special form of an If-Else-Step which simply has no No-Sequence`, emptyWidth=20) {
        if_branch(`<div align="right">
      Heading of the Yes-Sequence
    </div>`, plain=`Heading of the Yes-Sequence`) {
            simple(14.1, 9e7b3eea, `Steps being run in the Yes-Case`, plain=`Steps being run in the Yes-Case`);
        }
    }
    break(15, cc34178b, `<b>Exception 3</b>`, plain=`Exception 3`);
    case(16, 6780ede2, `Switch-Case-Step. At least the Else-Sequence and two other cases are 
    mandatory. Otherwise use If-Else or If.`, plain=`Switch-Case-Step. At least the Else-Sequence and two other cases are mandatory. Otherwise use If-Else or If.`, cols=[33.09%, 33.24%, 33.09%]) {
        default_branch(`Heading of the Else-Sequence`, plain=`Heading of the Else-Sequence`) {
            simple(16.1, d2c724ae, `Steps being run in the Else-Case`, plain=`Steps being run in the Else-Case`);
        }
        case_branch(`Heading if the Case 1 sequence`, plain=`Heading if the Case 1 sequence`) {
            simple(17.1, 4e2561d0, `Steps being run in case 1`, plain=`Steps being run in case 1`);
        }
        case_branch(`Heading if the Case 2 sequence`, plain=`Heading if the Case 2 sequence`) {
            simple(18.1, 20767ac6, `Steps being run in case 2`, plain=`Steps being run in case 2`);
        }
    }
    subsequence(19, c652cc9a, `<b>Subsequence</b>`, plain=`Subsequence`) {
        simple(19.1, 95119fac, `Steps being run in this subsequence`, plain=`Steps being run in this subsequence`);
    }
    break(20, 8140bd66, `<b>Exception 4 - no catch - this is allowed</b>`, plain=`Exception 4 - no catch - this is allowed`);
    simple(21, 74324c0f, `<div>
      Step moved in orange change set. Empty source step appears with orange 
      background and step number with black background, showing both, the 
      source step number itself, followed by the number where the step has 
      been moved to.
    </div>
    <div>
      The moved step appears with white background and an orange step number 
      including the source step number.
    </div>`, plain=`Step moved in orange change set. Empty source step appears with orange background and step number with black background, showing both, the source step number itself, followed by the number where the step has been moved to.
The moved step appears with white background and an orange step number including the source step number.`, change=(target, orange));
    simple(22, 848844aa, `<div>
      This step illustrates complex formatting. In general, text size and 
      weight is expressed by HTML formatting like
    </div>
    <div>
      <b>bold</b>
    </div>
    <div>
      <i>italic</i>
    </div>
    <div>
      <u>underlined</u>
    </div>
    <div>
      
    </div>
    <div>
      Lists are not expressed by HTML but by appropriate edit areas like that 
      for unordered lists:
    </div>`, plain=`This step illustrates complex formatting. In general, text size and weight is expressed by HTML formatting like
bold
italic
underlined

Lists are not expressed by HTML but by appropriate edit areas like that for unordered lists:`) {
        list(ordered=false) {
            item(`unordered list item 1`, plain=`unordered list item 1`)
            item(`unordered list item 2`, plain=`unordered list item 2`)
        }
        text(`<div>
      For ordered lists:
    </div>`, plain=`For ordered lists:`)
        list(ordered=true) {
            item(`ordered list item 1`, plain=`ordered list item 1`)
            item(`ordered list item 2`, plain=`ordered list item 2`)
        }
        text(`Lists cannot be nested`, plain=`Lists cannot be nested`)
    }
    simple(23, 43789041, `<div>
      As for list items, also tables are not expressed by HTML but by special 
      edit areas like this. However, the first edit area in every edit 
      container must be a text edit area, even if it is empty!
    </div>`, plain=`As for list items, also tables are not expressed by HTML but by special edit areas like this. However, the first edit area in every edit container must be a text edit area, even if it is empty!`) {
        table(width=100%) {
            row { cell(`<b>Spalte 1</b>`, plain=`Spalte 1`) | cell(`<b>Spalte 2</b>`, plain=`Spalte 2`) | cell(`<b>Spalte 3</b>`, plain=`Spalte 3`) }
            row { cell(`You might place nested tables or list items in the cells of a table`, plain=`You might place nested tables or list items in the cells of a table`) | cell(`Zelle 2.1`, plain=`Zelle 2.1`) | cell(`Zelle 3.1`, plain=`Zelle 3.1`) }
        }
    }
    simple(24, 1bc7bfe4, `<div>
      Supported headings
    </div>
    <h1>
      Heading 1
    </h1>
    <h2>
      Heading 2
    </h2>
    <h3>
      Heading 3
    </h3>
    <h4>
      Heading 4
    </h4>
    <h5>
      Heading 5
    </h5>
    <h6>
      Heading 6
    </h6>`, plain=`Supported headings
Heading 1
Heading 2
Heading 3
Heading 4
Heading 5
Heading 6`);
    simple(25, 74194b87, `<div>
      Supported font sizes
    </div>
    <div>
      <font size="1">xx-small</font>
    </div>
    <div>
      <font size="2">x-smal</font>
    </div>
    <div>
      <font size="3">small</font>
    </div>
    <div>
      <font size="4">middle (default)</font>
    </div>
    <div>
      <font size="5">big</font>
    </div>
    <div>
      <font size="6">x-big</font>
    </div>
    <div>
      <font size="7">xx-big</font>
    </div>`, plain=`Supported font sizes
xx-small
x-smal
small
middle (default)
big
x-big
xx-big`);
    simple(26, a7479633, `<div>
      Supported fonts are
    </div>
    <div>
      Sitka - Serif (default font)
    </div>
    <div>
      <font face="Roboto">Roboto - Sans Serif</font>
    </div>
    <div>
      <font face="CourierPrime">Courier - Monospace</font>
    </div>`, plain=`Supported fonts are
Sitka - Serif (default font)
Roboto - Sans Serif
Courier - Monospace`);
    simple(27, 360b3fe8, `<div>
      Text might have a pre-formatted text section. Only preformatted text 
      keeps all its whitespaces while multiple whitespaces in other text 
      sections are eliminated when saving. Pre-formatted text is always 
      displayed in a monospaced font.
    </div>
    <pre>This<br>  text<br>    is<br>  pre  -  formatted<br></pre>`, plain=`Text might have a pre-formatted text section. Only preformatted text keeps all its whitespaces while multiple whitespaces in other text sections are eliminated when saving. Pre-formatted text is always displayed in a monospaced font.
This   text     is   pre  -  formatted `);
    simple(28, 475b9003, `Step with rounded border decoration.`, plain=`Step with rounded border decoration.`);
    simple(29, 7d70cd2a, `Following step with border decoration. There is no gap line displayed in a 
    sequence of steps with this decoration.`, plain=`Following step with border decoration. There is no gap line displayed in a sequence of steps with this decoration.`);
    catch(10, `<b>Exception 1 - should have single line text</b>`, plain=`Exception 1 - should have single line text`) {
        coCatch(15, `<b>Exception 3</b>`, plain=`Exception 3`);
        simple(10.1, cabe94ec, `Sequence for handling the exception in case it occured in break step 10 The 
    catch step has the same number as the break step. Catch sequences may 
    occur at the end of the sequence where the break step is in or at the end 
    of any sequence on a higher level.`, plain=`Sequence for handling the exception in case it occured in break step 10 The catch step has the same number as the break step. Catch sequences may occur at the end of the sequence where the break step is in or at the end of any sequence on a higher level.`, markups=[(69,70,Steplink)]);
        simple(10.2, eb2308cd, `Exception 3 shares the same exception handling with Exception 1, so it was 
    added as a &quot;Co-Catch&quot; in the same handling sequence.`, plain=`Exception 3 shares the same exception handling with Exception 1, so it was added as a "Co-Catch" in the same handling sequence.`);
    }
    catch(13, `<b>Exception 2</b>`, plain=`Exception 2`) {
        simple(13.1, e739cdd5, `Sequence for handling the second exception`, plain=`Sequence for handling the second exception`);
    }
}

outro(`This is the outro of a usecase`, plain=`This is the outro of a usecase`) {
}
